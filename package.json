{
  "name": "weekly-dinner-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc --noEmit -p tsconfig.server.json",
    "build:full": "npm run build && npm run build:server",
    "start": "tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.22.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
